%%
s = tf('s');

L = (s+1)^(-2) * s^(-2);

S = 1/(1+L);

T = L/(1+L);

display(S);

bodemag(L);
grid On;
legend;

%%
%Redes de adelanto y atraso
s = tf('s');
C_adelanto = 10 * (s+1)/(s+100); %adelanto a < b
C_atraso = 0.1* (s + 100)/(s+1); %atraso b < a

bode(C_atraso, C_adelanto);
grid On;
legend;

%%
%controlar una planta con red de atraso
P = 3* (s + 1) / (s + 10);
k = 0.319;
C = k * /s;
L = C * P;
S = 1/(1 + L);
T = L/(1 + L);

margin(L);
grid On;
legend;

%%